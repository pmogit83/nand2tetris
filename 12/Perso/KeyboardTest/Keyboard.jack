/**
 * A library for handling user input from the keyboard.
 */
class Keyboard {
	static int m_nKeyboardReg;		// Keyboard register
	static int m_nLineMaxLength;	// Max length of a line

    /** Initializes the keyboard. */
    function void init() {
		let m_nKeyboardReg = 24576;
		let m_nLineMaxLength = 63;	// arbitrary
		
		return;
    }

    /**
     * Returns the character of the currently pressed key on the keyboard;
     * if no key is currently pressed, returns 0.
     *
     * Recognizes all ASCII characters, as well as the following keys:
     * new line = 128 = String.newline()
     * backspace = 129 = String.backspace()
     * left arrow = 130
     * up arrow = 131
     * right arrow = 132
     * down arrow = 133
     * home = 134
     * End = 135
     * page up = 136
     * page down = 137
     * insert = 138
     * delete = 139
     * ESC = 140
     * F1 - F12 = 141 - 152
     */
    function char keyPressed() {
		return Memory.peek(m_nKeyboardReg);
    }

	function boolean isPrintable(char c) {
		return ( (c < 127) & (c > 31) );
	}

    /**								
     * Waits until a key is pressed on the keyboard and released,
     * then echoes the key to the screen, and returns the character 
     * of the pressed key.
     */
    function char readChar() {
		var char c0, c;

		// Display the cursor [cf. Output.initMap()] :
		do Output.printCharOnly(0);

		// Wait until a key is pressed :
		let c0 = Keyboard.keyPressed();
		while (c0 = 0) {
			let c0 = Keyboard.keyPressed();
		}

		// Wait until the key is released :
		let c = c0;
		while (~(c = 0)) {
			let c = Keyboard.keyPressed();
		}

		// Display c at the current cursor location :
		if (Keyboard.isPrintable(c0)) {
			do Output.printChar(c0);
		}
		else {
			if (c0 = String.newLine()) {
				// Clear cursor :
				do Output.printCharOnly(32);
			}
		}

		return c0;
    }

    /**								
     * Displays the message on the screen, reads from the keyboard the entered
     * text until a newline character is detected, echoes the text to the screen,
     * and returns its value. Also handles user backspaces.
     */
    function String readLine(String message) {
		var String s;
		var char c;
		
		do Output.printString(message);

		// + 1 for the final '\0' :
		let s = String.new(m_nLineMaxLength + 1);
		let c = 0;
		while (c = 0) {
			let c = Keyboard.readChar();
			if (c = String.newLine()) {
				do Output.println();
				return s;
			}
			if (c = String.backSpace()) {
				if (s.length() > 0) {
					do Output.printCharOnly(32);
					do s.eraseLastChar();
					do Output.backSpace();
				}
			}
			else {
				if (s.length() < m_nLineMaxLength) {
					let s = s.appendChar(c);
				}
			}
			let c = 0;			
		}

		return s;
    }   

    /**								
     * Displays the message on the screen, reads from the keyboard the entered
     * text until a newline character is detected, echoes the text to the screen,
     * and returns its integer value (until the first non-digit character in the
     * entered text is detected). Also handles user backspaces. 
     */
	function int readInt(String message) {
		var int nRead;
		var String s;
		var char c;
		
		do Output.printString(message);

		// + 1 for the final '\0' :
		let s = String.new(m_nLineMaxLength + 1);
		let c = 0;
 		while (c = 0) {
 			let c = Keyboard.readChar();
 			if (c = String.newLine()) {
 				do Output.println();
 				let nRead = s.intValue();
 				return nRead;
 			}
			if (c = String.backSpace()) {
				if (s.length() > 0) {
					do Output.printCharOnly(32);
					do s.eraseLastChar();
					do Output.backSpace();
				}
			}
			else {
				if (s.length() < m_nLineMaxLength) {
					let s = s.appendChar(c);
				}
			}
			let c = 0;			
 		}

		return nRead;
	}
}
