// File name: projects/03/a/Bit.hdl

/**
 * 1-bit register:
 * If load[t] == 1 then out[t+1] = in[t]
 *                 else out does not change (out[t+1] = out[t])
 */

CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // Put your code here:
	// __ Sources : Ch. 3 p. 43, fig. 3.1 + Annexe 2 HDL, A2.4 § feedback loops
	
	// This code runs fine although 'dffOut' is not initialized ! The code is 
	// directly based on the figure p. 43 and on the following remarks :
	// - We have 3 inputs for Mux : 'in', the DFF output and 'load'.
	// - Mux must emit 'in' when load = 1 so we necessarily have b=in and  
	// sel=load
	// - Only the 'a' pin can receive the DFF output. Calling this output 
	// 'dffOut', we obtain a=dffOut (letting aside the initialization problem 
	// described above).
	// - If we call 'muxOut' the Mux output, we finaly get :
	Mux(a=dffOut, b=in, sel=load, out=muxOut);

	// - The DFF input is necessarily the Mux output, so 'muxOut'.
	// - The DFF output has been called 'dffOut', so we get :
    DFF(in=muxOut, out=dffOut);

	// - We are left with emiting the output signal, 'out' (knowing that 
	// x Or false = x) :
    Or(a=dffOut, b=false, out=out);
}
