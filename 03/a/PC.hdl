/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16], load, reset, inc;
    OUT out[16];

    PARTS:
    // Put your code here:
	// __ If reset = 1, we will output 'zero' :
	Not16(in=true, out=zero);
	// __ Reg + 1 computation (NB : regOut is set below !) :
 	Inc16(in=regOut, out=regPlusOne);
	// __ We build a 3 bits selector :
	// 	reset 	load	inc		regLoad		regIn
	//	-----	----	-----	-------		---------------
	// 	0		0		0		0			Not relevant
	// 	0		0		1		1			regPlusOne
	// 	0		1		0		1			in
	// 	0		1		1		1			in
	// 	1		0		0		0			zero
	// 	1		0		1		1			zero
	// 	1		1		0		1			zero
	// 	1		1		1		1			zero
	Or16(a=false, b[0]=inc, b[1]=load, b[2]=reset, b[3..15]=false, out[0..2]=triSel);
	// __ We choose 'regIn' according to 'triSel' : 000 => in (Not relevant), 
	// 001 => regPlusOne etc.
	Mux8Way16(a=in, b=regPlusOne, c=in, d=in, e=zero, f=zero, g=zero, h=zero, sel=triSel, out=regIn);
	// __ regLoad = reset Or load Or inc :
	Or(a=reset, b=load, out=rOrl);
	Or(a=rOrl, b=inc, out=regLoad);
	// __ Feeding the register according to 'regLoad' (NB : the output can be 
	// emitted several times !) : 
	Register(in=regIn, load=regLoad, out=regOut, out=out);
}
