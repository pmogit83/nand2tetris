/**
 * ************************************************************ PERSO :
 * Memory of 2 registers, 16 bit-wide. Out holds the value stored in the 
 * register selected : first register if sel = 0, second register if sel = 1.
 * If load==1, then the in value is loaded into the selected register (the 
 * loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM2 {
    IN in[16], load, sel;
    OUT out[16];

    PARTS:
    // Put your code here:

/*
	load	sel		loadr0	loadr1		
	-----------------------------------------
	true	0		true	false
	true	1		false	true
	false	0		false	false
	false	1		false	false
	
	loadr0 = load And Not(sel)
	loadr1 = load And sel
*/

	Not(in=sel, out=notsel);
	And(a=load, b=notsel, out=loadr0);
	And(a=load, b=sel, out=loadr1);

	Register(in=in, load=loadr0, out=r0);
	Register(in=in, load=loadr1, out=r1);

	// __ Sortie en fonction de sel :
	Mux16(a=r0, b=r1, sel=sel, out=out);

}
